#Область ПрограммныйИнтерфейс

// ---------- Настройки ----------

Функция КлючНастроек() Экспорт
	Возврат "SQLSync";
КонецФункции

Функция КлючЗадания() Экспорт
	Возврат "SQLSyncПолная";
КонецФункции

// Возвращает структуру настроек. Недостающие ключи заполняются значениями по умолчанию.
Функция ПолучитьНастройки() Экспорт

	Настройки = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Настройки");
	Если Настройки = Неопределено Тогда
		Возврат НастройкиПоУмолчанию();
	КонецЕсли;

	Возврат ДополнитьНастройки(Настройки);

КонецФункции

Процедура СохранитьНастройки(Настройки) Экспорт

	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Настройки", Настройки);

КонецПроцедуры

// ---------- Триггеры ----------

// Вызывается из модуля управляемого приложения при запуске системы.
Процедура ВыполнитьПриЗапуске() Экспорт

	Если ПолучитьНастройки().СинхронизироватьПриЗапуске Тогда
		ЗапуститьПолнуюСинхронизациюВФоне();
	КонецЕсли;

КонецПроцедуры

// Запускает полную синхронизацию в фоновом задании. Дубликаты не создаются.
Процедура ЗапуститьПолнуюСинхронизациюВФоне() Экспорт

	Если ПолучитьНастройки().Объекты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура("Ключ, Состояние", КлючЗадания(), СостояниеФоновогоЗадания.Активно);
	Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	ФоновыеЗадания.Выполнить("Ext1_СинхронизацияSQL.ВыполнитьПолнуюСинхронизацию", ,
		КлючЗадания(), НСтр("ru = 'Синхронизация с SQL'"));

КонецПроцедуры

// Подписка на событие ПриЗаписи справочников и документов.
// Только ставит объект в очередь в той же транзакции. SQL здесь не вызывается.
Процедура ПриЗаписиОбъекта(Источник, Отказ) Экспорт

	Настройки = ПолучитьНастройки();
	Если Не Настройки.СинхронизироватьПриЗаписи Тогда
		Возврат;
	КонецЕсли;

	Если Настройки.Объекты.Найти(Источник.Метаданные().ПолноеИмя()) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.Ext1_ОчередьСинхронизацииSQL.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Источник.Ссылка;
	МенеджерЗаписи.ДатаИзменения = ТекущаяДата();
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Регламентное задание: синхронизирует объекты из очереди.
Процедура ОбработатьОчередь() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Q.Объект КАК Объект
	               |ИЗ
	               |	РегистрСведений.Ext1_ОчередьСинхронизацииSQL КАК Q";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Подключение = Неопределено;
	Попытка
		Подключение = ПодключитьсяКSQL();
	Исключение
		ЗаписатьОшибку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Попытка
			СинхронизироватьОбъект(Подключение, Выборка.Объект);

			Набор = РегистрыСведений.Ext1_ОчередьСинхронизацииSQL.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Выборка.Объект);
			Набор.Записать();
		Исключение
			// Запись остаётся в очереди и будет обработана при следующем запуске
			ЗаписатьОшибку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	ЗакрытьПодключение(Подключение);

КонецПроцедуры

// Фоновое задание: полная выгрузка всех выбранных объектов.
Процедура ВыполнитьПолнуюСинхронизацию() Экспорт

	Список = СформироватьСписокОбъектов();
	Если Список.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Подключение = Неопределено;
	Попытка
		Подключение = ПодключитьсяКSQL();
		ВыгрузитьВсеВSQL(Подключение, Список);

		Данные = Новый Соответствие;
		Для Каждого Элемент Из Список Цикл
			Данные.Вставить(Элемент.Имя, ПрочитатьИзSQL(Подключение, Элемент));
		КонецЦикла;

		ОбработатьДанныеИзSQL(Данные);
	Исключение
		ЗаписатьОшибку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗакрытьПодключение(Подключение);

КонецПроцедуры

// Применяет интервал и флаг использования к регламентному заданию.
Процедура ПрименитьРасписание() Экспорт

	Настройки = ПолучитьНастройки();

	Задание = РегламентныеЗадания.НайтиПредопределенное("Ext1_СинхронизацияSQL_ОбработкаОчереди");
	Если Задание = Неопределено Тогда
		ВызватьИсключение "Не найдено регламентное задание Ext1_СинхронизацияSQL_ОбработкаОчереди";
	КонецЕсли;

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = Макс(1, Настройки.ИнтервалМинут) * 60;
	Расписание.ВремяНачала = Дата(1, 1, 1, 0, 0, 0);
	Расписание.ВремяКонца = Дата(1, 1, 1, 23, 59, 59);

	Задание.Расписание = Расписание;
	Задание.Использование = Настройки.ИспользоватьРегламентноеЗадание;
	Задание.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

Функция НастройкиПоУмолчанию()

	// Формат строки подключения соответствует OPI_MSSQL.СформироватьСтрокуПодключения
	Возврат Новый Структура("СтрокаПодключения, Объекты, СинхронизироватьПриЗаписи, СинхронизироватьПриЗапуске, ИспользоватьРегламентноеЗадание, ИнтервалМинут",
		"Server=HOME-PC\SQLEXPRESS;Database=PCRETAIL;IntegratedSecurity=True;",
		Новый Массив, Ложь, Ложь, Ложь, 5);

КонецФункции

Функция ДополнитьНастройки(Настройки)

	Умолчания = НастройкиПоУмолчанию();
	Для Каждого Пара Из Умолчания Цикл
		Если Не Настройки.Свойство(Пара.Ключ) Тогда
			Настройки.Вставить(Пара.Ключ, Пара.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Настройки;

КонецФункции

Процедура ЗаписатьОшибку(Текст)
	ЗаписьЖурналаРегистрации("SQLSync", УровеньЖурналаРегистрации.Ошибка, , , Текст);
КонецПроцедуры

// Открывает соединение через коннектор Ext1_OPI_MSSQL (внешняя компонента OPI_MSSQL).
// При ошибке вызывает исключение с текстом из компоненты.
Функция ПодключитьсяКSQL()

	Настройки = ПолучитьНастройки();
	Если ПустаяСтрока(Настройки.СтрокаПодключения) Тогда
		ВызватьИсключение "Не задана строка подключения к SQL";
	КонецЕсли;

	Результат = Ext1_OPI_MSSQL.ОткрытьСоединение(Настройки.СтрокаПодключения);
	Если Не Ext1_OPI_MSSQL.ЭтоКоннектор(Результат) Тогда
		ВызватьИсключение "Не удалось подключиться к SQL: " + ТекстОшибкиOPI(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ЗакрытьПодключение(Подключение)

	Если Подключение <> Неопределено Тогда
		Попытка
			Ext1_OPI_MSSQL.ЗакрытьСоединение(Подключение);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Извлекает текст ошибки из ответа OPI (поля error или errors[].error).
Функция ТекстОшибкиOPI(Результат)

	Ошибка = Ext1_OPI_Инструменты.ПолучитьИли(Результат, "error", "");
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Возврат Строка(Ошибка);
	КонецЕсли;

	Ошибки = Ext1_OPI_Инструменты.ПолучитьИли(Результат, "errors", Неопределено);
	Если ТипЗнч(Ошибки) = Тип("Массив") И Ошибки.Количество() > 0 Тогда
		Возврат Строка(Ext1_OPI_Инструменты.ПолучитьИли(Ошибки[0], "error", "неизвестная ошибка"));
	КонецЕсли;

	Возврат "неизвестная ошибка";

КонецФункции

// Проверяет ответ OPI: при result = Ложь вызывает исключение с контекстом.
Процедура ПроверитьРезультат(Результат, Контекст)

	Успех = Ext1_OPI_Инструменты.ПолучитьИли(Результат, "result", Ложь);
	Если Успех <> Истина Тогда
		ВызватьИсключение Контекст + ": " + ТекстОшибкиOPI(Результат);
	КонецЕсли;

КонецПроцедуры

Функция СформироватьСписокОбъектов()

	Список = Новый Массив;
	Для Каждого ОбъектМД Из ОбъектыДляСинхронизации() Цикл
		Список.Добавить(ОписаниеОбъекта(ОбъектМД));
	КонецЦикла;

	Возврат Список;

КонецФункции

Функция ОбъектыДляСинхронизации()

	Результат = Новый Массив;
	Для Каждого ПолноеИмя Из ПолучитьНастройки().Объекты Цикл
		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОбъектМД <> Неопределено Тогда
			Результат.Добавить(ОбъектМД);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Описание таблицы SQL для одного объекта метаданных.
// Служебные поля 1С не переносятся. Ссылка хранится как GUID.
Функция ОписаниеОбъекта(ОбъектМД)

	Вид = СтрРазделить(ОбъектМД.ПолноеИмя(), ".")[0];
	Колонки = Новый Массив;
	Использованные = Новый Соответствие;

	ДобавитьКолонку(Колонки, Использованные, "Ссылка_GUID", "Ссылка", "NVARCHAR(36)");

	Если Вид = "Справочник" Тогда
		ДобавитьКолонку(Колонки, Использованные, "Код", "Код", "NVARCHAR(50)");
		ДобавитьКолонку(Колонки, Использованные, "Наименование", "Наименование", "NVARCHAR(500)");
	Иначе
		ДобавитьКолонку(Колонки, Использованные, "Номер", "Номер", "NVARCHAR(50)");
		ДобавитьКолонку(Колонки, Использованные, "Дата", "Дата", "DATETIME2");
		ДобавитьКолонку(Колонки, Использованные, "Проведен", "Проведен", "BIT");
	КонецЕсли;

	Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, ТипSQL(Реквизит.Тип));
	КонецЦикла;

	Возврат Новый Структура("Вид, Имя, ОбъектМД, Колонки",
		Вид, СтрЗаменить(ОбъектМД.ПолноеИмя(), ".", "_"), ОбъектМД, Колонки);

КонецФункции

Процедура ДобавитьКолонку(Колонки, Использованные, Имя, Источник, ТипКолонки)

	Если Использованные[Имя] <> Неопределено Тогда
		Возврат; // защита от дубликатов имён
	КонецЕсли;

	Использованные.Вставить(Имя, Истина);
	Колонки.Добавить(Новый Структура("Имя, Источник, ТипSQL", Имя, Источник, ТипКолонки));

КонецПроцедуры

Функция ТипSQL(ОписаниеТипов)

	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() = 1 Тогда
		ТипЭлемента = Типы[0];
		Если ТипЭлемента = Тип("Число") Тогда
			Возврат "DECIMAL(19,4)";
		ИначеЕсли ТипЭлемента = Тип("Дата") Тогда
			Возврат "DATETIME2";
		ИначеЕсли ТипЭлемента = Тип("Булево") Тогда
			Возврат "BIT";
		ИначеЕсли ТипЭлемента = Тип("Строка") Тогда
			Возврат "NVARCHAR(MAX)";
		КонецЕсли;
	КонецЕсли;

	Возврат "NVARCHAR(MAX)"; // ссылки и составные типы хранятся текстом

КонецФункции

Функция ЗначениеПоля(Выборка, Имя)

	Попытка
		Возврат Выборка[Имя];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// ---------- Выгрузка в SQL через коннектор OPI ----------

// Тип-ключ структуры значения для ДобавитьЗаписи / ОбновитьЗаписи (см. таблицу типов OPI MSSQL).
Функция КлючТипаOPI(ТипSQL)

	Если СтрНачинаетсяС(ТипSQL, "DECIMAL") Тогда
		Возврат "DECIMAL";
	ИначеЕсли СтрНачинаетсяС(ТипSQL, "DATETIME") Тогда
		Возврат "DATETIME";
	ИначеЕсли ТипSQL = "BIT" Тогда
		Возврат "BIT";
	Иначе
		Возврат "NVARCHAR";
	КонецЕсли;

КонецФункции

// Приводит значение 1С к виду, который принимает OPI: Неопределено для NULL,
// булево и число как есть, ссылки и прочее как строка (ссылки - GUID).
Функция ЗначениеДляOPI(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Значение, Неопределено);
	КонецЕсли;

	Попытка
		Если Значение.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
	КонецПопытки;

	Возврат Строка(Значение);

КонецФункции

// Значение в виде структуры {'Тип данных': Значение}, как требует OPI.
Функция ТипизированноеЗначение(Значение, ТипSQL)

	Возврат Новый Структура(КлючТипаOPI(ТипSQL), ЗначениеДляOPI(Значение));

КонецФункции

// Строки объекта (все или одна по ссылке) в виде массива структур для ДобавитьЗаписи.
Функция ПолучитьСтрокиДляВставки(Элемент, Ссылка)

	Строки = Новый Массив;

	Запрос = Новый Запрос;
	Текст = "ВЫБРАТЬ * ИЗ " + Элемент.ОбъектМД.ПолноеИмя() + " КАК Т";
	Если Ссылка <> Неопределено Тогда
		Текст = Текст + " ГДЕ Т.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
	КонецЕсли;
	Запрос.Текст = Текст;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ЗаписьSQL = Новый Структура;
		Для Каждого Колонка Из Элемент.Колонки Цикл
			Значение = ЗначениеПоля(Выборка, Колонка.Источник);
			ЗаписьSQL.Вставить(Колонка.Имя, ТипизированноеЗначение(Значение, Колонка.ТипSQL));
		КонецЦикла;
		Строки.Добавить(ЗаписьSQL);
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Создаёт таблицу, если её нет. Существующая таблица приводится к составу колонок
// (лишние колонки удаляются вместе с данными - см. README).
Процедура СоздатьТаблицуЕслиНужно(Подключение, Элемент)

	СтруктураКолонок = Новый Структура;
	Для Каждого Колонка Из Элемент.Колонки Цикл
		СтруктураКолонок.Вставить(Колонка.Имя, Колонка.ТипSQL);
	КонецЦикла;

	Результат = Ext1_OPI_MSSQL.ГарантироватьТаблицу(Элемент.Имя, СтруктураКолонок, Подключение);
	ПроверитьРезультат(Результат, "Создание таблицы " + Элемент.Имя);

КонецПроцедуры

// Полная выгрузка: очистка и вставка всех строк по каждому объекту.
// Внимание: транзакция действует в пределах одной таблицы, а не всей выгрузки.
Процедура ВыгрузитьВсеВSQL(Подключение, Список)

	Для Каждого Элемент Из Список Цикл

		СоздатьТаблицуЕслиНужно(Подключение, Элемент);

		Результат = Ext1_OPI_MSSQL.УдалитьЗаписи(Элемент.Имя, , Подключение);
		ПроверитьРезультат(Результат, "Очистка таблицы " + Элемент.Имя);

		Строки = ПолучитьСтрокиДляВставки(Элемент, Неопределено);
		Если Строки.Количество() > 0 Тогда
			Результат = Ext1_OPI_MSSQL.ДобавитьЗаписи(Элемент.Имя, Строки, Истина, Подключение);
			ПроверитьРезультат(Результат, "Вставка в таблицу " + Элемент.Имя);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Один объект: удаляет его строку по GUID и вставляет текущее состояние.
Процедура СинхронизироватьОбъект(Подключение, Ссылка)

	Элемент = ОписаниеОбъекта(Ссылка.Метаданные());
	СоздатьТаблицуЕслиНужно(Подключение, Элемент);

	Фильтр = Ext1_OPI_MSSQL.ПолучитьСтруктуруФильтраЗаписей(Истина);
	Фильтр.field = "Ссылка_GUID";
	Фильтр.type  = "=";
	Фильтр.value = Строка(Ссылка.УникальныйИдентификатор());
	Фильтр.union = "AND";
	Фильтр.raw   = Ложь;

	Фильтры = Новый Массив;
	Фильтры.Добавить(Фильтр);

	Результат = Ext1_OPI_MSSQL.УдалитьЗаписи(Элемент.Имя, Фильтры, Подключение);
	ПроверитьРезультат(Результат, "Удаление строки объекта в " + Элемент.Имя);

	Строки = ПолучитьСтрокиДляВставки(Элемент, Ссылка);
	Если Строки.Количество() > 0 Тогда
		Результат = Ext1_OPI_MSSQL.ДобавитьЗаписи(Элемент.Имя, Строки, Истина, Подключение);
		ПроверитьРезультат(Результат, "Вставка строки объекта в " + Элемент.Имя);
	КонецЕсли;

КонецПроцедуры

// Читает таблицу из SQL через коннектор. Возвращает ТаблицуЗначений.
Функция ПрочитатьИзSQL(Подключение, Элемент)

	Результат = Ext1_OPI_MSSQL.ПолучитьЗаписи(Элемент.Имя, , , , , Подключение);

	Строки = Результат;
	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		ПроверитьРезультат(Результат, "Чтение таблицы " + Элемент.Имя);
		Строки = Ext1_OPI_Инструменты.ПолучитьИли(Результат, "data", Новый Массив);
	КонецЕсли;

	ТЗ = Новый ТаблицаЗначений;
	Для Каждого Колонка Из Элемент.Колонки Цикл
		ТЗ.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Для Каждого ЗаписьSQL Из Строки Цикл
		НоваяСтрока = ТЗ.Добавить();
		Для Каждого Колонка Из Элемент.Колонки Цикл
			НоваяСтрока[Колонка.Имя] = Ext1_OPI_Инструменты.ПолучитьИли(ЗаписьSQL, Колонка.Имя, Неопределено);
		КонецЦикла;
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

