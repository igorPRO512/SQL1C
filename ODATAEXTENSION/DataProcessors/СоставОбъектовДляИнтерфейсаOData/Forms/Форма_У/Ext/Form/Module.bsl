
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// проверяем допустимость версии
	Попытка
		МассивРазрешений = ПолучитьСоставСтандартногоИнтерфейсаOData();
		УстановитьСоставСтандартногоИнтерфейсаOData(МассивРазрешений);
	Исключение
		Элементы.СтраницыОбработки.ТекущаяСтраница = Элементы.СтраницаПредупреждения;
		СисИнфо = Новый СистемнаяИнформация; 
		Предупреждение = 
				"Или ваша версия "+СисИнфо.ВерсияПриложения+
				" или режим совместимости """+Метаданные.РежимСовместимости+
				""" не совместимы с данной обработкой!"+Символы.ПС+Символы.ПС+
				"Требуется версия 8.3.5 или выше.";
		Возврат;
	КонецПопытки;
	
	ЗаполнитьТаблицуМетаданных();
	
КонецПроцедуры



&НаКлиенте
Процедура ВыполнитьИзменение(Команда)
	
	ВыполнитьИзменениеНаСервере();
	
	РазвернутьВеткиДерева();
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьИзменениеНаСервере()

	МассивРазрешений = Новый Массив;
	
	ДеревоМетаданных = РеквизитФормыВЗначение("ТаблицаМетаданных");
	Для каждого СтрокаТаблицы Из ДеревоМетаданных.Строки Цикл
		Для каждого СтрокаРаздела Из СтрокаТаблицы.Строки Цикл
			Если СтрокаРаздела.Пометка Тогда
				ЭлементМетаданных = Метаданные[СтрокаТаблицы.Метаданные][СтрокаРаздела.Метаданные];
				МассивРазрешений.Добавить(ЭлементМетаданных);
			КонецЕсли; 
		КонецЦикла;
	КонецЦикла;
	
	УстановитьСоставСтандартногоИнтерфейсаOData(МассивРазрешений);
	
	ЗаполнитьТаблицуМетаданных();
	
КонецПроцедуры // ВыполнитьИзменениеНаСервере()
 


&НаКлиенте
Процедура Обновить(Команда)
	
	ЗаполнитьТаблицуМетаданных();
	
	РазвернутьВеткиДерева();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуМетаданных()

	ДеревоМетаданных = РеквизитФормыВЗначение("ТаблицаМетаданных");
	ДеревоМетаданных.Строки.Очистить();
	
	МассивРазрешений = ПолучитьСоставСтандартногоИнтерфейсаOData();
	
	ДобавитьРазделТаблицыМетаданных("Справочники", ДеревоМетаданных.Строки, "Справочники", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Документы", ДеревоМетаданных.Строки, "Документы", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Журналы документов", ДеревоМетаданных.Строки, "ЖурналыДокументов", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Планы обменов", ДеревоМетаданных.Строки, "ПланыОбмена", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Планы счетов", ДеревоМетаданных.Строки, "ПланыСчетов", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Планы видов расчетов", ДеревоМетаданных.Строки, "ПланыВидовРасчета", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Планы видов характеристик", ДеревоМетаданных.Строки, "ПланыВидовХарактеристик", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Регистры бухгалтерии", ДеревоМетаданных.Строки, "РегистрыБухгалтерии", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Регистры сведений", ДеревоМетаданных.Строки, "РегистрыСведений", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Регистры расчетов", ДеревоМетаданных.Строки, "РегистрыРасчета", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Регистры накоплений", ДеревоМетаданных.Строки, "РегистрыНакопления", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Константы", ДеревоМетаданных.Строки, "Константы", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Перечисления", ДеревоМетаданных.Строки, "Перечисления", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Бизнес-процессы", ДеревоМетаданных.Строки, "БизнесПроцессы", МассивРазрешений);
	ДобавитьРазделТаблицыМетаданных("Задачи", ДеревоМетаданных.Строки, "Задачи", МассивРазрешений);
	
	ЗначениеВРеквизитФормы(ДеревоМетаданных, "ТаблицаМетаданных");
	
КонецПроцедуры // ЗаполнитьТаблицуМетаданных()
 
&НаСервере
Процедура ДобавитьРазделТаблицыМетаданных(НазваниеРаздела, СтрокиРазделов, НазваниеКоллекцияМетаданных, МассивРазрешений)

	КоллекцияМетаданных = Метаданные[НазваниеКоллекцияМетаданных];
	
	Если КоллекцияМетаданных.Количество()>0 Тогда
		ЗаписьРаздела = СтрокиРазделов.Добавить();
		ЗаписьРаздела.Пометка = Ложь;
		ЗаписьРаздела.ПредыдущаяПометка = Ложь;
		ЗаписьРаздела.Данные = НазваниеРаздела;
		ЗаписьРаздела.Метаданные = НазваниеКоллекцияМетаданных;
		//***
		Для каждого ЭлементМетаданных Из КоллекцияМетаданных Цикл
			ЗаписьЭлемента = ЗаписьРаздела.Строки.Добавить();
			ЗаписьЭлемента.Метаданные = ЭлементМетаданных.Имя;
			ЗаписьЭлемента.Данные = " "+ЭлементМетаданных.Синоним;
			ЗаписьЭлемента.Пометка = не (МассивРазрешений.Найти(ЭлементМетаданных)=Неопределено);
			ЗаписьЭлемента.ПредыдущаяПометка = ЗаписьЭлемента.Пометка;
			ЗаписьЭлемента.КартинкаДо = БиблиотекаКартинок.Реквизит;
			ЗаписьЭлемента.КартинкаПосле = БиблиотекаКартинок.Изменить;
		КонецЦикла; 
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВеткиДерева()

	СтрокиДерева = ТаблицаМетаданных.ПолучитьЭлементы();
	Для каждого СтрокаДерева Из СтрокиДерева Цикл
		Элементы.ТаблицаМетаданных.Развернуть(СтрокаДерева.ПолучитьИдентификатор());
	КонецЦикла; 

КонецПроцедуры
 

&НаКлиенте
Процедура ТаблицаМетаданныхПометкаПриИзменении(Элемент)
	
	СтрокаДерева = ТаблицаМетаданных.НайтиПоИдентификатору(Элементы.ТаблицаМетаданных.ТекущаяСтрока);
	
	Подстроки = СтрокаДерева.ПолучитьЭлементы();
	Для каждого Подстрока Из Подстроки Цикл
		Подстрока.Пометка = СтрокаДерева.Пометка;
	КонецЦикла; 
	
КонецПроцедуры
 