#Область ПрограммныйИнтерфейс

// ---------- Настройки ----------

Функция КлючНастроек() Экспорт
	Возврат "SQLSync";
КонецФункции

Функция КлючЗадания() Экспорт
	Возврат "SQLSyncПолная";
КонецФункции

Функция ПолучитьНастройки() Экспорт

	Настройки = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Настройки");
	Если Настройки = Неопределено Тогда
		Возврат НастройкиПоУмолчанию();
	КонецЕсли;

	Возврат ДополнитьНастройки(Настройки);

КонецФункции

Процедура СохранитьНастройки(Настройки) Экспорт

	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Настройки", Настройки);

КонецПроцедуры

// ---------- Триггеры ----------

Процедура ВыполнитьПриЗапуске() Экспорт

	Если ПолучитьНастройки().СинхронизироватьПриЗапуске Тогда
		ЗапуститьПолнуюСинхронизациюВФоне();
	КонецЕсли;

КонецПроцедуры

Процедура ЗапуститьПолнуюСинхронизациюВФоне() Экспорт

	Если ПолучитьНастройки().Объекты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Отбор = Новый Структура("Ключ, Состояние", КлючЗадания(), СостояниеФоновогоЗадания.Активно);
	Если ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	ФоновыеЗадания.Выполнить("Ext1_СинхронизацияSQL.ВыполнитьПолнуюСинхронизацию", ,
		КлючЗадания(), НСтр("ru = 'Синхронизация с SQL'"));

КонецПроцедуры

// Подписка на ПриЗаписи: только ставит объект в очередь, SQL здесь не вызывается.
Процедура ПриЗаписиОбъекта(Источник, Отказ) Экспорт

	Настройки = ПолучитьНастройки();
	Если Не Настройки.СинхронизироватьПриЗаписи Тогда
		Возврат;
	КонецЕсли;

	Если Настройки.Объекты.Найти(Источник.Метаданные().ПолноеИмя()) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.Ext1_ОчередьСинхронизацииSQL.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Источник.Ссылка;
	МенеджерЗаписи.ДатаИзменения = ТекущаяДата();
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Регламентное задание: выгружает изменённые объекты из очереди.
Процедура ОбработатьОчередь() Экспорт

	ОтладочноеСообщение("Начало обработки очереди синхронизации.");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Q.Объект КАК Объект
	               |ИЗ
	               |	РегистрСведений.Ext1_ОчередьСинхронизацииSQL КАК Q";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		ОтладочноеСообщение("Очередь пуста.");
		Возврат;
	КонецЕсли;

	Подключение = Неопределено;
	Попытка
		Подключение = ПодключитьсяКSQL();
	Исключение
		ЗаписатьОшибку(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОтладочноеСообщение("Не удалось подключиться к SQL для обработки очереди: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Попытка
			ОтладочноеСообщение("Очередь: экспорт объекта " + Строка(Выборка.Объект));
			Элемент = ОписаниеОбъекта(Выборка.Объект.Метаданные());
			ВыгрузитьОбъект(Подключение, Элемент, Выборка.Объект);

			Набор = РегистрыСведений.Ext1_ОчередьСинхронизацииSQL.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(Выборка.Объект);
			Набор.Записать();
		Исключение
			// Запись остаётся в очереди и будет обработана при следующем запуске
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписатьОшибку(ТекстОшибки);
			ОтладочноеСообщение("Ошибка обработки элемента очереди "
				+ Строка(Выборка.Объект) + ": " + ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	ЗакрытьПодключение(Подключение);
	ОтладочноеСообщение("Обработка очереди завершена.");

КонецПроцедуры

// Обёртка для запуска из интерфейса: возвращает текст ошибки или пустую строку.
Функция ВыполнитьПолнуюСинхронизациюБезопасно() Экспорт

	Попытка
		ВыполнитьПолнуюСинхронизацию();
		Возврат "";
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибку(ТекстОшибки);
		ОтладочноеСообщение("Синхронизация завершилась ошибкой: " + ТекстОшибки);
		Возврат ТекстОшибки;
	КонецПопытки;

КонецФункции

// Полная синхронизация: создать таблицы, безопасно импортировать из SQL, выгрузить 1С в SQL.
Процедура ВыполнитьПолнуюСинхронизацию() Экспорт

	Настройки = ПолучитьНастройки();
	ОтладочноеСообщение("Начало полной синхронизации. Объектов настроено: " + Строка(Настройки.Объекты.Количество()));

	Список = СформироватьСписокОбъектов();
	Если Список.Количество() = 0 Тогда
		ВызватьИсключение "Не выбрано ни одного объекта для синхронизации в настройках!";
	КонецЕсли;

	ОтладочноеСообщение("Формирование описаний завершено. Объектов: " + Строка(Список.Количество()));
	Подключение = Неопределено;
	Попытка
		Подключение = ПодключитьсяКSQL();
		Для Каждого Элемент Из Список Цикл
			Элемент.Вставить("ОшибкиИмпорта", Новый Соответствие);
		КонецЦикла;
		ОтладочноеСообщение("SQL подключение установлено. Создаю/проверяю структуру таблиц.");
		СоздатьТаблицы(Подключение, Список);
		ОтладочноеСообщение("Структура таблиц готова. Начинаю импорт SQL -> 1С.");
		ИмпортироватьИзSQL(Подключение, Список);
		ОтладочноеСообщение("Импорт SQL -> 1С завершен. Начинаю экспорт 1С -> SQL.");
		ВыгрузитьВсеВSQL(Подключение, Список);
	Исключение
		ОтладочноеСообщение("Синхронизация прервана: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗакрытьПодключение(Подключение);
		ВызватьИсключение;
	КонецПопытки;

	ОбновитьПовторноИспользуемыеЗначения();
	ЗакрытьПодключение(Подключение);
	ОтладочноеСообщение("Полная синхронизация завершена.");

КонецПроцедуры

Процедура ПрименитьРасписание() Экспорт

	Настройки = ПолучитьНастройки();

	Задание = РегламентныеЗадания.НайтиПредопределенное("Ext1_СинхронизацияSQL_ОбработкаОчереди");
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = Макс(1, Настройки.ИнтервалМинут) * 60;
	Расписание.ВремяНачала = Дата(1, 1, 1, 0, 0, 0);
	Расписание.ВремяКонца = Дата(1, 1, 1, 23, 59, 59);

	Задание.Расписание = Расписание;
	Задание.Использование = Настройки.ИспользоватьРегламентноеЗадание;
	Задание.Записать();

КонецПроцедуры

#КонецОбласти

#Область Импорт

// Импорт из SQL в 1С:
//  - создаются только отсутствующие объекты;
//  - NULL и пустые строки из SQL не очищают реквизиты;
//  - документы записываются с проведением;
//  - каждая строка изолирована: ошибка в одной строке не останавливает импорт.
Процедура ИмпортироватьИзSQL(Подключение, Список)

	Для Каждого Элемент Из Список Цикл
		Если Элемент.Вид <> "Справочник" И Элемент.Вид <> "Документ" Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ИмпортироватьТаблицу(Подключение, Элемент);
		Исключение
			ТекстОшибки = "Импорт таблицы " + Элемент.Имя + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписатьОшибку(ТекстОшибки);
			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ИмпортироватьТаблицу(Подключение, Элемент)

	Статистика = Новый Структура("Прочитано, Создано, Обновлено, Пропущено, Ошибок", 0, 0, 0, 0, 0);

	Рс = Новый COMОбъект("ADODB.Recordset");
	ТекстЗапроса = ЗапросИмпортаТаблицы(Элемент);
	ОтладочноеСообщение("Импорт таблицы " + Элемент.Имя + ". Запрос: " + ТекстЗапроса);
	Рс.Open(ТекстЗапроса, Подключение, 0, 1);

	Пока Не Рс.EOF Цикл
		Статистика.Прочитано = Статистика.Прочитано + 1;
		Попытка
			ИмпортироватьСтроку(Элемент, Рс, Статистика);
		Исключение
			Статистика.Ошибок = Статистика.Ошибок + 1;
			GUIDОшибки = ЗначениеПолеSQL(Рс, "Ссылка_GUID");
			Элемент.ОшибкиИмпорта.Вставить(НРег(GUIDОшибки), Истина);
			ТекстОшибки = "Импорт, таблица " + Элемент.Имя + ", GUID " + GUIDОшибки
				+ ": объект не будет выгружен обратно в SQL. "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписатьОшибку(ТекстОшибки);
			ОтладочноеСообщение(ТекстОшибки);
		КонецПопытки;
		Рс.MoveNext();
	КонецЦикла;

	Рс.Close();

	ЗаписьЖурналаРегистрации("SQLSync", УровеньЖурналаРегистрации.Информация, , ,
		"Импорт " + Элемент.Имя + ": прочитано " + Статистика.Прочитано + ", создано " + Статистика.Создано
		+ ", обновлено " + Статистика.Обновлено + ", пропущено " + Статистика.Пропущено
		+ ", ошибок " + Статистика.Ошибок);
	ОтладочноеСообщение("Импорт таблицы " + Элемент.Имя + " завершен: прочитано "
		+ Строка(Статистика.Прочитано) + ", создано " + Строка(Статистика.Создано)
		+ ", обновлено " + Строка(Статистика.Обновлено) + ", пропущено "
		+ Строка(Статистика.Пропущено) + ", ошибок " + Строка(Статистика.Ошибок));

КонецПроцедуры

Функция ЗапросИмпортаТаблицы(Элемент)

	Выражения = "";
	Индекс = 0;
	Для Каждого Колонка Из Элемент.Колонки Цикл
		Если Выражения <> "" Тогда
			Выражения = Выражения + ", ";
		КонецЕсли;

		Если Колонка.Категория = "Строка" Тогда
			Индекс = Индекс + 1;
			Колонка.Вставить("ПолеДлиныSQL", "__SQLSyncBytes" + Строка(Индекс));
			Выражения = Выражения + "CONVERT(NVARCHAR(4000), [" + Колонка.Имя + "]) AS ["
				+ Колонка.Имя + "], DATALENGTH([" + Колонка.Имя + "]) AS ["
				+ Колонка.ПолеДлиныSQL + "]";
		Иначе
			Выражения = Выражения + "[" + Колонка.Имя + "]";
		КонецЕсли;
	КонецЦикла;

	Возврат "SELECT " + Выражения + " FROM [" + Элемент.Имя + "]";

КонецФункции

Процедура ИмпортироватьСтроку(Элемент, Рс, Статистика)

	GUID = Строка(Рс.Fields.Item("Ссылка_GUID").Value);
	ОтладочноеСообщение("Импорт объекта " + Элемент.Имя + ", GUID=" + GUID);
	Ссылка = ПолучитьСсылкуПоМенеджеру(Элемент.ОбъектМД, GUID);

	Если ОбъектЕстьВБазе(Элемент.ОбъектМД, Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Создан = Ложь;
		ОтладочноеСообщение("Объект найден в 1С, обновляю существующий.");
	Иначе
		Объект = СоздатьОбъект(Элемент, Ссылка, Рс);
		Создан = Истина;
		ОтладочноеСообщение("Объект отсутствует в 1С, создаю новый.");
	КонецЕсли;

	Если Элемент.Вид = "Справочник" И Элемент.ОбъектМД.Иерархический Тогда
		ПолеГруппы = Рс.Fields.Item("ЭтоГруппа").Value;
		Если ПолеГруппы <> NULL И ПолеГруппы <> Неопределено
			И БулевоИзSQL(ПолеГруппы) <> Объект.ЭтоГруппа Тогда
			ВызватьИсключение "Нельзя изменить тип элемента иерархического справочника (группа/элемент)";
		КонецЕсли;
	КонецЕсли;

	Изменен = Ложь;
	Для Каждого Колонка Из Элемент.Колонки Цикл
		Если Колонка.Категория = "Служебный" Или Колонка.Категория = "Хранилище"
			Или Колонка.Категория = "АвтоДатаИзменения" Или Колонка.Имя = "Проведен"
			Или Колонка.Имя = "ЭтоГруппа" Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ПолеSQL = Рс.Fields.Item(Колонка.Имя);
			Если Колонка.Категория = "Строка" Тогда
				РазмерСтрокиSQL = Рс.Fields.Item(Колонка.ПолеДлиныSQL).Value;
				Если РазмерСтрокиSQL <> NULL И РазмерСтрокиSQL <> Неопределено
					И РазмерСтрокиSQL > 8000 Тогда
					ВызватьИсключение "Строковое поле " + Колонка.Имя
						+ " содержит более 4000 символов; значение не будет усечено.";
				КонецЕсли;
			КонецЕсли;
			ЗначениеSQL = ЗначениеПоляДляИмпорта(ПолеSQL, Колонка);
			Если Колонка.Категория = "Строка"
				И ЗначениеSQL = "" И ПолеSQL.ActualSize > 0 Тогда
				ВызватьИсключение "SQL содержит строковые данные, но они прочитаны пустыми: " + Колонка.Имя;
			КонецЕсли;
			Значение = ЗначениеИзSQL(ЗначениеSQL, Колонка);
			Если Колонка.Категория = "Строка"
				И ТипЗнч(ЗначениеSQL) = Тип("Строка")
				И ЗначениеSQL <> "" И Значение = "" Тогда
				ВызватьИсключение "Импорт строки " + Колонка.Имя
					+ ": непустое SQL-значение стало пустым после преобразования; объект не будет выгружен обратно.";
			КонецЕсли;
			ТекстОтладкиПоля = "Поле " + Колонка.Имя + ": SQL тип="
				+ Строка(ТипЗнч(ЗначениеSQL)) + ", 1С тип=" + Строка(ТипЗнч(Значение))
				+ ", значение=[" + ПредставлениеДляОтладки(Значение) + "]";
			Если Колонка.Категория = "Строка" Тогда
				Если ТипЗнч(ЗначениеSQL) = Тип("Строка") Тогда
					ТекстОтладкиПоля = ТекстОтладкиПоля + ", длина строки SQL="
						+ Строка(СтрДлина(ЗначениеSQL)) + ", длина после преобразования="
						+ Строка(СтрДлина(Значение)) + ", DATALENGTH SQL="
						+ Строка(РазмерСтрокиSQL) + ", ActualSize=" + Строка(ПолеSQL.ActualSize);
				КонецЕсли;
			КонецЕсли;
			ОтладочноеСообщение(ТекстОтладкиПоля);
		Исключение
			ВызватьИсключение "Импорт, поле " + Колонка.Имя + " (" + Элемент.Имя + ", GUID " + GUID + "): "
				+ ОписаниеОшибки();
		КонецПопытки;

		Если Значение = Неопределено Тогда
			ОтладочноеСообщение("Поле " + Колонка.Имя + " пропущено: SQL NULL.");
			Продолжить;
		КонецЕсли;

		Если Колонка.Категория = "Строка" И Значение = "" Тогда
			ОтладочноеСообщение("Поле " + Колонка.Имя
				+ " пропущено: пустая SQL-строка не импортируется.");
			Продолжить;
		КонецЕсли;

		Если Объект[Колонка.Источник] = Значение Тогда
			ОтладочноеСообщение("Поле " + Колонка.Имя + " не изменилось.");
			Продолжить;
		КонецЕсли;

		Объект[Колонка.Источник] = Значение;
		Изменен = Истина;
		ОтладочноеСообщение("Поле " + Колонка.Имя + " установлено в объект.");
	КонецЦикла;

	Если Не Создан И Не Изменен И Элемент.Вид <> "Документ" Тогда
		Статистика.Пропущено = Статистика.Пропущено + 1;
		Возврат;
	КонецЕсли;

	Если Элемент.Вид = "Документ" Тогда
		ОтладочноеСообщение("Записываю документ с проведением.");
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ОтладочноеСообщение("Записываю элемент справочника.");
		Объект.Записать();
	КонецЕсли;
	ОтладочноеСообщение("Объект " + GUID + " успешно записан в 1С.");

	Если Создан Тогда
		Статистика.Создано = Статистика.Создано + 1;
	Иначе
		Статистика.Обновлено = Статистика.Обновлено + 1;
	КонецЕсли;

КонецПроцедуры

// Преобразование значения SQL в значение 1С по категории колонки.
Функция ЗначениеПоляДляИмпорта(Поле, Колонка)

	Возврат Поле.Value;

КонецФункции

Функция ЗначениеИзSQL(ЗначениеSQL, Колонка)

	Если ЗначениеSQL = NULL Или ЗначениеSQL = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Категория = Колонка.Категория;

	Если Категория = "Строка" Тогда
		Если ТипЗнч(ЗначениеSQL) <> Тип("Строка") Тогда
			ВызватьИсключение "SQL вернул нетекстовое значение для строкового поля " + Колонка.Имя;
		КонецЕсли;
		Текст = ЗначениеSQL;
		Если Колонка.Длина > 0 И СтрДлина(Текст) > Колонка.Длина Тогда
			ЗаписатьОшибку("Импорт, поле " + Колонка.Имя + ": значение обрезано с " + СтрДлина(Текст)
				+ " до " + Колонка.Длина + " символов");
			Текст = Лев(Текст, Колонка.Длина);
		КонецЕсли;
		Возврат Текст;

	ИначеЕсли Категория = "Число" Тогда
		Если ТипЗнч(ЗначениеSQL) = Тип("Число") Тогда
			Возврат ЗначениеSQL;
		КонецЕсли;
		Возврат ЧислоИзСтроки(Строка(ЗначениеSQL));

	ИначеЕсли Категория = "Булево" Тогда
		Если ТипЗнч(ЗначениеSQL) = Тип("Булево") Тогда
			Возврат ЗначениеSQL;
		КонецЕсли;
		Возврат Строка(ЗначениеSQL) = "1";

	ИначеЕсли Категория = "Дата" Тогда
		Если ТипЗнч(ЗначениеSQL) = Тип("Дата") Тогда
			Возврат ?(ЗначениеЗаполнено(ЗначениеSQL), ЗначениеSQL, Неопределено);
		КонецЕсли;
		Возврат ДатаИзСтроки(Строка(ЗначениеSQL));

	ИначеЕсли Категория = "Ссылка" Тогда
		Текст = СокрЛП(Строка(ЗначениеSQL));
		Если Текст = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПолучитьСсылкуПоВиду(Колонка.ВидСсылки, Колонка.ИмяСсылки, Текст);

	ИначеЕсли Категория = "Перечисление" Тогда
		Текст = СокрЛП(Строка(ЗначениеSQL));
		Если Текст = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЗначениеПеречисленияПоИмени(Колонка.ИмяПеречисления, Текст);

	ИначеЕсли Категория = "Бинарные" Тогда
		Возврат Base64Значение(Строка(ЗначениеSQL));

	ИначеЕсли Категория = "УИД" Тогда
		Возврат УникальныйИдентификаторИзSQL(ЗначениеSQL, Колонка.Имя);

	ИначеЕсли Категория = "Составной" Тогда
		Возврат ЗначениеИзКомпозита(Строка(ЗначениеSQL));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Составной формат хранения: "Тип|значение", например "Строка|текст" или "СправочникСсылка.Товары|GUID".
Функция ЗначениеИзКомпозита(Текст)

	Поз = СтрНайти(Текст, "|");
	Если Поз = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	ИмяТипа = Лев(Текст, Поз - 1);
	ТекстЗначения = Сред(Текст, Поз + 1);

	Если ИмяТипа = "Строка" Тогда
		Возврат ТекстЗначения;
	ИначеЕсли ИмяТипа = "Число" Тогда
		Возврат ЧислоИзСтроки(ТекстЗначения);
	ИначеЕсли ИмяТипа = "Булево" Тогда
		Возврат ТекстЗначения = "1";
	ИначеЕсли ИмяТипа = "Дата" Тогда
		Возврат ДатаИзСтроки(ТекстЗначения);
	ИначеЕсли ИмяТипа = "ДвоичныеДанные" Тогда
		Возврат Base64Значение(ТекстЗначения);
	ИначеЕсли ИмяТипа = "УникальныйИдентификатор" Тогда
		Возврат УникальныйИдентификаторИзSQL(ТекстЗначения, ИмяТипа);
	КонецЕсли;

	Точка = СтрНайти(ИмяТипа, ".");
	Если Точка = 0 Тогда
		ВызватьИсключение "Неизвестный составной тип: " + ИмяТипа;
	КонецЕсли;

	Префикс = Лев(ИмяТипа, Точка - 1);
	ИмяОбъекта = Сред(ИмяТипа, Точка + 1);

	Если Префикс = "ПеречислениеСсылка" Тогда
		Возврат ЗначениеПеречисленияПоИмени(ИмяОбъекта, ТекстЗначения);
	КонецЕсли;

	Если СтрДлина(Префикс) > 6 И Прав(Префикс, 6) = "Ссылка" Тогда
		Возврат ПолучитьСсылкуПоВиду(Лев(Префикс, СтрДлина(Префикс) - 6), ИмяОбъекта, ТекстЗначения);
	КонецЕсли;

	ВызватьИсключение "Неподдерживаемый составной тип: " + ИмяТипа;

КонецФункции

Функция УникальныйИдентификаторИзSQL(ЗначениеSQL, ИмяПоля)

	Если ЗначениеSQL = NULL Или ЗначениеSQL = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекстУИД = СокрЛП(Строка(ЗначениеSQL));
	Если ТекстУИД = "" Тогда
		ЗаписатьОшибку("Импорт, поле " + ИмяПоля + ": в SQL пустой УИД; значение пропущено.");
		ОтладочноеСообщение("Поле " + ИмяПоля + ": SQL УИД пуст, значение пропущено.");
		Возврат Неопределено;
	КонецЕсли;

	Если СтрДлина(ТекстУИД) = 38 И Лев(ТекстУИД, 1) = "{" И Прав(ТекстУИД, 1) = "}" Тогда
		ТекстУИД = Сред(ТекстУИД, 2, 36);
	КонецЕсли;

	Если СтрДлина(ТекстУИД) <> 36 Тогда
		ЗаписатьОшибку("Импорт, поле " + ИмяПоля + ": некорректная длина SQL УИД ("
			+ Строка(СтрДлина(ТекстУИД)) + "); значение пропущено.");
		ОтладочноеСообщение("Поле " + ИмяПоля + ": некорректный SQL УИД=["
			+ ПредставлениеДляОтладки(ТекстУИД) + "], значение пропущено.");
		Возврат Неопределено;
	КонецЕсли;

	Для ИндексСимвола = 1 По 36 Цикл
		СимволУИД = Сред(ТекстУИД, ИндексСимвола, 1);
		Если ИндексСимвола = 9 Или ИндексСимвола = 14
			Или ИндексСимвола = 19 Или ИндексСимвола = 24 Тогда
			Если СимволУИД <> "-" Тогда
				ЗаписатьОшибку("Импорт, поле " + ИмяПоля + ": неверный формат SQL УИД; значение пропущено.");
				ОтладочноеСообщение("Поле " + ИмяПоля + ": SQL УИД имеет неверный формат, значение пропущено.");
				Возврат Неопределено;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789abcdefABCDEF", СимволУИД) = 0 Тогда
			ЗаписатьОшибку("Импорт, поле " + ИмяПоля + ": SQL УИД содержит недопустимый символ; значение пропущено.");
			ОтладочноеСообщение("Поле " + ИмяПоля + ": SQL УИД содержит недопустимый символ, значение пропущено.");
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Возврат Новый УникальныйИдентификатор(ТекстУИД);
	Исключение
		ЗаписатьОшибку("Импорт, поле " + ИмяПоля + ": платформа отклонила SQL УИД=["
			+ ТекстУИД + "]; значение пропущено. " + ОписаниеОшибки());
		ОтладочноеСообщение("Поле " + ИмяПоля + ": платформа отклонила SQL УИД=["
			+ ТекстУИД + "], значение пропущено.");
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ВыгрузкаВSQL

// Полная выгрузка 1С в SQL: каждый объект пишется отдельно в своей транзакции.
// Ошибка одного объекта не останавливает выгрузку остальных.
Процедура ВыгрузитьВсеВSQL(Подключение, Список)

	Для Каждого Элемент Из Список Цикл
		ОтладочноеСообщение("Экспорт таблицы " + Элемент.Имя + " из объекта метаданных "
			+ Элемент.ОбъектМД.ПолноеИмя());
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ " + Элемент.ОбъектМД.ПолноеИмя() + " КАК Т";
		Выборка = Запрос.Выполнить().Выбрать();

		Выгружено = 0;
		Ошибок = 0;
		Пока Выборка.Следующий() Цикл
			GUID = НРег(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			Если Элемент.ОшибкиИмпорта[GUID] = Истина Тогда
				Ошибок = Ошибок + 1;
				ОтладочноеСообщение("Экспорт пропущен для GUID=" + GUID
					+ ": ранее была ошибка импорта этого объекта.");
				Продолжить;
			КонецЕсли;

			Попытка
				ОтладочноеСообщение("Экспорт объекта GUID=" + GUID);
				ВыгрузитьОбъект(Подключение, Элемент, Выборка.Ссылка);
				Выгружено = Выгружено + 1;
			Исключение
				Ошибок = Ошибок + 1;
				ТекстОшибки = "Выгрузка " + Элемент.Имя + ", объект " + Строка(Выборка.Ссылка) + ": "
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписатьОшибку(ТекстОшибки);
				ОтладочноеСообщение(ТекстОшибки);
			КонецПопытки;
		КонецЦикла;

		ЗаписьЖурналаРегистрации("SQLSync", УровеньЖурналаРегистрации.Информация, , ,
			"Выгрузка " + Элемент.Имя + ": выгружено " + Выгружено + ", ошибок " + Ошибок);
		ОтладочноеСообщение("Экспорт таблицы " + Элемент.Имя + " завершен: выгружено "
			+ Строка(Выгружено) + ", ошибок " + Строка(Ошибок));
	КонецЦикла;

КонецПроцедуры
// Один объект обновляется или добавляется в SQL в рамках транзакции.
Процедура ВыгрузитьОбъект(Подключение, Элемент, Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ " + Элемент.ОбъектМД.ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Объект не найден";
	КонецЕсли;

	GUID = Строка(Ссылка.УникальныйИдентификатор());

	Подключение.BeginTrans();
	Попытка
		СуществующаяСтрока = Новый COMОбъект("ADODB.Recordset");
		СуществующаяСтрока.Open("SELECT [Ссылка_GUID] FROM [" + Элемент.Имя
			+ "] WHERE [Ссылка_GUID] = '" + GUID + "'", Подключение, 0, 1);
		СтрокаСуществует = Не СуществующаяСтрока.EOF;
		СуществующаяСтрока.Close();

		Если СтрокаСуществует Тогда
			ОтладочноеСообщение("SQL: обновляю существующую строку GUID=" + GUID);
			Команда = Новый COMОбъект("ADODB.Command");
			Команда.ActiveConnection = Подключение;
			Команда.CommandType = 1;
			Установки = "";

			Для Каждого Колонка Из Элемент.Колонки Цикл
				Если Колонка.Категория = "Служебный" Тогда
					Продолжить;
				КонецЕсли;

				Если Колонка.Категория <> "АвтоДатаИзменения" Тогда
					ЗначениеПоля = ЗначениеПоляВыборки(Выборка, Колонка.Источник);
					Если Колонка.Категория = "Строка" И ЗначениеПоля = "" Тогда
						ОтладочноеСообщение("SQL UPDATE, поле " + Колонка.Имя
							+ " пропущено: пустая строка не очищает значение SQL.");
						Продолжить;
					КонецЕсли;
				КонецЕсли;

				Если Установки <> "" Тогда
					Установки = Установки + ", ";
				КонецЕсли;
				Если Колонка.Категория = "АвтоДатаИзменения" Тогда
					Установки = Установки + "[" + Колонка.Имя + "] = SYSDATETIME()";
				Иначе
					Установки = Установки + "[" + Колонка.Имя + "] = ?";
					ПараметрSQL = ПараметрДляSQL(ЗначениеПоля, Колонка);
					ОтладочноеСообщение("SQL UPDATE, поле " + Колонка.Имя
						+ ", категория=" + Колонка.Категория + ", значение="
						+ ПредставлениеДляОтладки(ПараметрSQL.Значение));
					Команда.Parameters.Append(ПараметрADO(Команда, ПараметрSQL.ТипADO,
						ПараметрSQL.Размер, ПараметрSQL.Значение));
				КонецЕсли;
			КонецЦикла;

			Если Установки <> "" Тогда
				Команда.CommandText = "UPDATE [" + Элемент.Имя + "] SET " + Установки
					+ " WHERE [Ссылка_GUID] = ?";
				Команда.Parameters.Append(ПараметрADO(Команда, 202, 36, GUID));
				Команда.Execute();
			Иначе
				ОтладочноеСообщение("SQL UPDATE пропущен: нет значений для обновления GUID=" + GUID);
			КонецЕсли;
		Иначе
			ОтладочноеСообщение("SQL: добавляю новую строку GUID=" + GUID);
			ВставитьОбъектВSQL(Подключение, Элемент, Выборка, GUID);
		КонецЕсли;

		Подключение.CommitTrans();
		ОтладочноеСообщение("SQL: транзакция успешно завершена для GUID=" + GUID);
	Исключение
		ОтладочноеСообщение("SQL: откат транзакции для GUID=" + GUID + ": "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Подключение.RollbackTrans();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ВставитьОбъектВSQL(Подключение, Элемент, Выборка, GUID)

	ИменаКолонок = "";
	Знаки = "";
	Команда = Новый COMОбъект("ADODB.Command");
	Команда.ActiveConnection = Подключение;
	Команда.CommandType = 1;

	Для Каждого Колонка Из Элемент.Колонки Цикл
		Если ИменаКолонок <> "" Тогда
			ИменаКолонок = ИменаКолонок + ", ";
			Знаки = Знаки + ", ";
		КонецЕсли;
		ИменаКолонок = ИменаКолонок + "[" + Колонка.Имя + "]";

		Если Колонка.Категория = "Служебный" Тогда
			Знаки = Знаки + "?";
			Команда.Parameters.Append(ПараметрADO(Команда, 202, 36, GUID));
		ИначеЕсли Колонка.Категория = "АвтоДатаИзменения" Тогда
			Знаки = Знаки + "SYSDATETIME()";
		Иначе
			Знаки = Знаки + "?";
			ПараметрSQL = ПараметрДляSQL(ЗначениеПоляВыборки(Выборка, Колонка.Источник), Колонка);
			ОтладочноеСообщение("SQL INSERT, поле " + Колонка.Имя
				+ ", категория=" + Колонка.Категория + ", значение="
				+ ПредставлениеДляОтладки(ПараметрSQL.Значение));
			Команда.Parameters.Append(ПараметрADO(Команда, ПараметрSQL.ТипADO,
				ПараметрSQL.Размер, ПараметрSQL.Значение));
		КонецЕсли;
	КонецЦикла;

	Команда.CommandText = "INSERT INTO [" + Элемент.Имя + "] (" + ИменаКолонок + ") VALUES (" + Знаки + ")";
	Команда.Execute();

КонецПроцедуры

// Значение 1С -> параметр ADODB. Каждая категория преобразуется отдельно, без склейки текста SQL.
Функция ПараметрДляSQL(Значение, Колонка)

	Категория = Колонка.Категория;

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат Параметр(202, 1, NULL);
	КонецЕсли;

	Если Категория = "Строка" Тогда
		Текст = Значение;
		ТипСтрокиADO = 202;
		Если СтрДлина(Текст) > 4000 Тогда
			ТипСтрокиADO = 203;
		КонецЕсли;
		Возврат Параметр(ТипСтрокиADO, Макс(1, СтрДлина(Текст)), Текст);

	ИначеЕсли Категория = "Число" Тогда
		// DECIMAL передаём строкой с точкой и фиксированным количеством знаков: не зависит от региональных настроек
		Возврат Параметр(202, 64, ФорматЧисла(Значение, Колонка.Масштаб));

	ИначеЕсли Категория = "Булево" Тогда
		Возврат Параметр(11, 1, Значение);

	ИначеЕсли Категория = "Дата" Тогда
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат Параметр(202, 1, NULL);
		КонецЕсли;
		Возврат Параметр(135, 1, Значение);

	ИначеЕсли Категория = "Ссылка" Тогда
		Если Значение.Пустая() Тогда
			Возврат Параметр(202, 1, NULL);
		КонецЕсли;
		Возврат Параметр(202, 36, Строка(Значение.УникальныйИдентификатор()));

	ИначеЕсли Категория = "Перечисление" Тогда
		Возврат Параметр(202, Макс(1, СтрДлина(Значение.Метаданные().Имя)), Значение.Метаданные().Имя);

	ИначеЕсли Категория = "Бинарные" Тогда
		Текст = Base64Строка(Значение);
		Возврат Параметр(202, Макс(1, СтрДлина(Текст)), Текст);

	ИначеЕсли Категория = "УИД" Тогда
		Возврат Параметр(202, 36, Строка(Значение));

	ИначеЕсли Категория = "Составной" Тогда
		Текст = КомпозитВСтроку(Значение, Колонка.Масштаб);
		Возврат Параметр(202, Макс(1, СтрДлина(Текст)), Текст);
	КонецЕсли;

	// Категория "Хранилище" и прочие: не выгружаются, в SQL пишется NULL
	Возврат Параметр(202, 1, NULL);

КонецФункции

// Составной тип: "Тип|значение"
Функция КомпозитВСтроку(Значение, Масштаб)

	ИмяТипа = Строка(ТипЗнч(Значение));
	ТипЗн = ТипЗнч(Значение);

	Если ТипЗн = Тип("Строка") Тогда
		Возврат "Строка|" + Значение;
	ИначеЕсли ТипЗн = Тип("Число") Тогда
		Возврат "Число|" + ФорматЧисла(Значение, Масштаб);
	ИначеЕсли ТипЗн = Тип("Булево") Тогда
		Возврат "Булево|" + ?(Значение, "1", "0");
	ИначеЕсли ТипЗн = Тип("Дата") Тогда
		Возврат "Дата|" + Формат(Значение, "ДФ=yyyy-MM-dd HH:mm:ss");
	ИначеЕсли ТипЗн = Тип("ДвоичныеДанные") Тогда
		Возврат "ДвоичныеДанные|" + Base64Строка(Значение);
	ИначеЕсли ТипЗн = Тип("УникальныйИдентификатор") Тогда
		Возврат "УникальныйИдентификатор|" + Строка(Значение);
	КонецЕсли;

	Если СтрНайти(ИмяТипа, "ПеречислениеСсылка") = 1 Тогда
		Возврат ИмяТипа + "|" + Значение.Метаданные().Имя;
	КонецЕсли;

	Возврат ИмяТипа + "|" + Строка(Значение.УникальныйИдентификатор());

КонецФункции

Функция ПараметрADO(Команда, ТипADO, Размер, Значение)

	Если Значение = NULL Тогда
		Возврат Команда.CreateParameter("", ТипADO, 1, 1, NULL);
	КонецЕсли;

	ПараметрCOM = Команда.CreateParameter("", ТипADO, 1, Размер, Значение);
	Если ТипADO = 203 Тогда
		ПараметрCOM.Attributes = 128;
	КонецЕсли;

	Возврат ПараметрCOM;

КонецФункции

