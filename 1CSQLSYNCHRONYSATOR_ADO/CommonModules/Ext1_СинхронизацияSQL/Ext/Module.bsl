Функция ОбъектЕстьВБазе(ОбъектМД, Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1 ИЗ " + ОбъектМД.ПолноеИмя() + " ГДЕ Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция СоздатьОбъект(Элемент, Ссылка, Рс)

	Если Элемент.Вид = "Документ" Тогда
		Объект = Документы[Элемент.ОбъектМД.Имя].СоздатьДокумент();
	ИначеЕсли Элемент.ОбъектМД.Иерархический
		И БулевоИзSQL(Рс.Fields.Item("ЭтоГруппа").Value) Тогда
		Объект = Справочники[Элемент.ОбъектМД.Имя].СоздатьГруппу();
	Иначе
		Объект = Справочники[Элемент.ОбъектМД.Имя].СоздатьЭлемент();
	КонецЕсли;

	Объект.УстановитьСсылкуНового(Ссылка);
	Возврат Объект;

КонецФункции

Функция БулевоИзSQL(Значение)

	Если Значение = NULL Или Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение) = "1" Или НРег(Строка(Значение)) = "true";

КонецФункции

Функция ПолучитьСсылкуПоМенеджеру(ОбъектМД, GUID)
	Возврат ПолучитьСсылкуПоВиду(ВидОбъекта(ОбъектМД), ОбъектМД.Имя, GUID);
КонецФункции

// Ссылка по виду метаданных ("Справочник", "Документ", ...) и имени объекта
Функция ПолучитьСсылкуПоВиду(Вид, Имя, GUID)

	УИД = Новый УникальныйИдентификатор(GUID);

	Если Вид = "Справочник" Тогда
		Возврат Справочники[Имя].ПолучитьСсылку(УИД);
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[Имя].ПолучитьСсылку(УИД);
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя].ПолучитьСсылку(УИД);
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя].ПолучитьСсылку(УИД);
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя].ПолучитьСсылку(УИД);
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[Имя].ПолучитьСсылку(УИД);
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Задачи[Имя].ПолучитьСсылку(УИД);
	КонецЕсли;

	ВызватьИсключение "Не поддерживается ссылочный тип: " + Вид;

КонецФункции

Функция ЗначениеПеречисленияПоИмени(ИмяПеречисления, ИмяЗначения)
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
КонецФункции

Процедура ОтладочноеСообщение(Текст)
	Если ПолучитьНастройки().РежимОтладки = Истина Тогда
		Сообщить("[SQLSync DEBUG] " + Текст);
	КонецЕсли;
КонецПроцедуры

Функция ПредставлениеДляОтладки(Значение)

	Если Значение = Неопределено Тогда
		Возврат "<Неопределено>";
	ИначеЕсли Значение = NULL Тогда
		Возврат "<NULL>";
	ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		Возврат "<ДвоичныеДанные>";
	КонецЕсли;

	Текст = ЭкранироватьУправляющиеСимволы(Строка(Значение));
	Если СтрДлина(Текст) > 160 Тогда
		Текст = Лев(Текст, 160) + "...";
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ЭкранироватьУправляющиеСимволы(Текст)

	Для Код = 0 По 31 Цикл
		Текст = СтрЗаменить(Текст, Символ(Код), "<CTRL-" + Строка(Код) + ">");
	КонецЦикла;
	Возврат СтрЗаменить(Текст, Символ(127), "<CTRL-127>");

КонецФункции

Процедура ЗаписатьОшибку(Текст)
	ЗаписьЖурналаРегистрации("SQLSync", УровеньЖурналаРегистрации.Ошибка, , , Текст);
КонецПроцедуры

Функция НастройкиПоУмолчанию()

	Возврат Новый Структура("СтрокаПодключения, Объекты, СинхронизироватьПриЗаписи, СинхронизироватьПриЗапуске, ИспользоватьРегламентноеЗадание, ИнтервалМинут, РежимОтладки",
		"Driver={ODBC Driver 17 for SQL Server};Server=HOME-PC\SQLEXPRESS;Database=PCRETAIL;Trusted_Connection=yes;TrustServerCertificate=Yes;",
		Новый Массив, Ложь, Ложь, Ложь, 5, Ложь);

КонецФункции

Функция ДополнитьНастройки(Настройки)

	Умолчания = НастройкиПоУмолчанию();
	Для Каждого Пара Из Умолчания Цикл
		Если Не Настройки.Свойство(Пара.Ключ) Тогда
			Настройки.Вставить(Пара.Ключ, Пара.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Настройки;

КонецФункции

Функция ПодключитьсяКSQL()

	Настройки = ПолучитьНастройки();
	Если ПустаяСтрока(Настройки.СтрокаПодключения) Тогда
		ВызватьИсключение "Не задана строка подключения к SQL";
	КонецЕсли;

	Подключение = Новый COMОбъект("ADODB.Connection");
	Подключение.ConnectionTimeout = 30;
	Подключение.CommandTimeout = 600;
	Подключение.Open(Настройки.СтрокаПодключения);

	Возврат Подключение;

КонецФункции

Процедура ЗакрытьПодключение(Подключение)

	Если Подключение <> Неопределено Тогда
		Попытка
			Подключение.Close();
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция СформироватьСписокОбъектов()

	Список = Новый Массив;
	Для Каждого ОбъектМД Из ОбъектыДляСинхронизации() Цикл
		Список.Добавить(ОписаниеОбъекта(ОбъектМД));
	КонецЦикла;

	Возврат Список;

КонецФункции

Функция ОбъектыДляСинхронизации()

	Результат = Новый Массив;
	Для Каждого ПолноеИмя Из ПолучитьНастройки().Объекты Цикл
		ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если ОбъектМД <> Неопределено Тогда
			Результат.Добавить(ОбъектМД);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
