#Область Служебные

Функция ВидОбъекта(ОбъектМД)
	Возврат СтрРазделить(ОбъектМД.ПолноеИмя(), ".")[0];
КонецФункции

Функция ДлинаСтрокиРеквизита(ОбъектМД, Источник)

	Если Источник = "Наименование" Тогда
		Попытка
			Возврат ОбъектМД.ДлинаНаименования;
		Исключение
			Возврат 0;
		КонецПопытки;
	ИначеЕсли Источник = "Код" Тогда
		Попытка
			Возврат ОбъектМД.ДлинаКода;
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецЕсли;

	Реквизит = ОбъектМД.Реквизиты.Найти(Источник);
	Если Реквизит = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если Реквизит.Тип.СодержитТип(Тип("Строка")) Тогда
		Возврат Реквизит.Тип.КвалификаторыСтроки.Длина;
	КонецЕсли;

	Возврат 0;

КонецФункции

Процедура ДобавитьКолонку(Колонки, Использованные, Имя, Источник, Категория, ТипSQL, Длина = 0,
	ВидСсылки = "", ИмяСсылки = "", ИмяПеречисления = "", Точность = 0, Масштаб = 0)

	Если Использованные[Имя] <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Использованные.Вставить(Имя, Истина);

	Колонки.Добавить(Новый Структура("Имя, Источник, Категория, ТипSQL, Длина, ВидСсылки, ИмяСсылки, ИмяПеречисления, Точность, Масштаб",
		Имя, Источник, Категория, ТипSQL, Длина, ВидСсылки, ИмяСсылки, ИмяПеречисления, Точность, Масштаб));

КонецПроцедуры

// Разделитель дробной части текущих региональных настроек
Функция РазделительДробной()
	Возврат Сред(Формат(1.5, "ЧН=0; ЧДЦ=1"), 2, 1);
КонецФункции

// Число в формате с точкой ("1234.5600") -> Число, независимо от региональных настроек
Функция ЧислоИзСтроки(Текст)

	Строка_ = СокрЛП(Текст);
	Если Строка_ = "" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(СтрЗаменить(Строка_, ".", РазделительДробной()));

КонецФункции

// Число -> строка с точкой и масштабом SQL-колонки
Функция ФорматЧисла(Значение, Масштаб = 4)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧДЦ=" + Строка(Масштаб) + "; ЧРД=.");
КонецФункции

// "yyyy-MM-dd HH:mm:ss" или "yyyy-MM-ddTHH:mm:ss..." -> Дата, иначе Неопределено
Функция ДатаИзСтроки(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) < 19 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Сред(Текст, 1, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)),
			Число(Сред(Текст, 12, 2)), Число(Сред(Текст, 15, 2)), Число(Сред(Текст, 18, 2)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

