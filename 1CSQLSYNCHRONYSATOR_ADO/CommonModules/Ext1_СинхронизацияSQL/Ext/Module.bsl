Процедура СоздатьТаблицы(Подключение, Список)

	Для Каждого Элемент Из Список Цикл
		ОтладочноеСообщение("Проверяю SQL-таблицу " + Элемент.Имя + ".");
		Текст = "";
		Для Каждого Колонка Из Элемент.Колонки Цикл
			ОтладочноеСообщение("Колонка " + Колонка.Имя + ": категория="
				+ Колонка.Категория + ", SQL-тип=" + Колонка.ТипSQL);
			Если Текст <> "" Тогда
				Текст = Текст + ", ";
			КонецЕсли;
			Текст = Текст + "[" + Колонка.Имя + "] " + Колонка.ТипSQL;
		КонецЦикла;

		Подключение.Execute("IF OBJECT_ID(N'[" + Элемент.Имя + "]', N'U') IS NULL CREATE TABLE ["
			+ Элемент.Имя + "] (" + Текст + ")");

		// Таблица могла быть создана раньше, без части реквизитов: добавляем недостающие колонки
		Для Каждого Колонка Из Элемент.Колонки Цикл
			Подключение.Execute("IF COL_LENGTH(N'[" + Элемент.Имя + "]', N'" + Колонка.Имя
				+ "') IS NULL ALTER TABLE [" + Элемент.Имя + "] ADD [" + Колонка.Имя + "] " + Колонка.ТипSQL);
		КонецЦикла;
		Подключение.Execute("IF COL_LENGTH(N'[" + Элемент.Имя
			+ "]', N'ДатаИзменения') IS NULL ALTER TABLE [" + Элемент.Имя
			+ "] ADD [ДатаИзменения] DATETIME2 NOT NULL DEFAULT (SYSDATETIME())");
		Подключение.Execute("UPDATE [" + Элемент.Имя
			+ "] SET [ДатаИзменения] = SYSDATETIME() WHERE [ДатаИзменения] IS NULL");
		ОтладочноеСообщение("SQL-таблица " + Элемент.Имя + " подготовлена.");
	КонецЦикла;

КонецПроцедуры

Функция ОписаниеОбъекта(ОбъектМД)

	Вид = ВидОбъекта(ОбъектМД);
	Колонки = Новый Массив;
	Использованные = Новый Соответствие;

	ДобавитьКолонку(Колонки, Использованные, "Ссылка_GUID", "Ссылка", "Служебный", "NVARCHAR(36)");

	Если Вид = "Справочник" Тогда
		ДобавитьКолонку(Колонки, Использованные, "Код", "Код", "Строка", "NVARCHAR(MAX)",
			ДлинаСтрокиРеквизита(ОбъектМД, "Код"));
		ДобавитьКолонку(Колонки, Использованные, "Наименование", "Наименование", "Строка", "NVARCHAR(MAX)",
			ДлинаСтрокиРеквизита(ОбъектМД, "Наименование"));
	ИначеЕсли Вид = "Документ" Тогда
		ДобавитьКолонку(Колонки, Использованные, "Номер", "Номер", "Строка", "NVARCHAR(MAX)",
			ДлинаСтрокиРеквизита(ОбъектМД, "Номер"));
		ДобавитьКолонку(Колонки, Использованные, "Дата", "Дата", "Дата", "DATETIME2");
		ДобавитьКолонку(Колонки, Использованные, "Проведен", "Проведен", "Булево", "BIT");
	КонецЕсли;

	Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
		Если Реквизит.Имя <> "ДатаИзменения" Тогда
			ДобавитьРеквизит(Колонки, Использованные, Реквизит);
		КонецЕсли;
	КонецЦикла;

	Если Вид = "Справочник" Тогда
		Если ОбъектМД.Иерархический Тогда
			ДобавитьКолонку(Колонки, Использованные, "Родитель", "Родитель", "Ссылка", "NVARCHAR(36)",
				0, "Справочник", ОбъектМД.Имя, "");
			ДобавитьКолонку(Колонки, Использованные, "ЭтоГруппа", "ЭтоГруппа", "Булево", "BIT");
		КонецЕсли;
		Если ОбъектМД.Владельцы.Количество() > 0 Тогда
			ДобавитьКолонку(Колонки, Использованные, "Владелец", "Владелец", "Составной", "NVARCHAR(MAX)");
		КонецЕсли;
		ДобавитьКолонку(Колонки, Использованные, "ПометкаУдаления", "ПометкаУдаления", "Булево", "BIT");
	ИначеЕсли Вид = "Документ" Тогда
		ДобавитьКолонку(Колонки, Использованные, "ПометкаУдаления", "ПометкаУдаления", "Булево", "BIT");
	КонецЕсли;

	ДобавитьКолонку(Колонки, Использованные, "ДатаИзменения", "ДатаИзменения",
		"АвтоДатаИзменения", "DATETIME2 NOT NULL DEFAULT (SYSDATETIME())");

	Возврат Новый Структура("Вид, Имя, ОбъектМД, Колонки",
		Вид, СтрЗаменить(ОбъектМД.ПолноеИмя(), ".", "_"), ОбъектМД, Колонки);

КонецФункции

Процедура ДобавитьРеквизит(Колонки, Использованные, Реквизит)

	Типы = Реквизит.Тип.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Типы.Количество() > 1 Тогда
		Масштаб = 0;
		Если Реквизит.Тип.СодержитТип(Тип("Число")) Тогда
			Масштаб = Реквизит.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
		КонецЕсли;
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя,
			"Составной", "NVARCHAR(MAX)", 0, "", "", "", 0, Масштаб);
		Возврат;
	КонецЕсли;

	ТипЭлемента = Типы[0];
	Если ТипЭлемента = Тип("Строка") Тогда
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Строка", "NVARCHAR(MAX)",
			Реквизит.Тип.КвалификаторыСтроки.Длина);
	ИначеЕсли ТипЭлемента = Тип("Число") Тогда
		Точность = Реквизит.Тип.КвалификаторыЧисла.Разрядность;
		Масштаб = Реквизит.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
		Если Точность < 1 Или Точность > 38 Тогда
			Точность = 38;
		КонецЕсли;
		Если Масштаб < 0 Или Масштаб > Точность Тогда
			Масштаб = Мин(Точность, Макс(0, Масштаб));
		КонецЕсли;
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Число",
			"DECIMAL(" + Строка(Точность) + "," + Строка(Масштаб) + ")", 0, "", "", "", Точность, Масштаб);
	ИначеЕсли ТипЭлемента = Тип("Булево") Тогда
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Булево", "BIT");
	ИначеЕсли ТипЭлемента = Тип("Дата") Тогда
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Дата", "DATETIME2");
	ИначеЕсли ТипЭлемента = Тип("ДвоичныеДанные") Тогда
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Бинарные", "NVARCHAR(MAX)");
	ИначеЕсли ТипЭлемента = Тип("УникальныйИдентификатор") Тогда
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "УИД", "NVARCHAR(36)");
	ИначеЕсли ТипЭлемента = Тип("ХранилищеЗначения") Тогда
		ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Хранилище", "NVARCHAR(MAX)");
	Иначе
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипЭлемента);
		Если МетаданныеТипа = Неопределено Тогда
			ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Составной", "NVARCHAR(MAX)");
			Возврат;
		КонецЕсли;

		ВидТипа = ВидОбъекта(МетаданныеТипа);
		Если ВидТипа = "Перечисление" Тогда
			ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Перечисление", "NVARCHAR(200)",
				0, "", "", МетаданныеТипа.Имя);
		ИначеЕсли ВидТипа = "Справочник" Или ВидТипа = "Документ" Или ВидТипа = "ПланВидовХарактеристик"
			Или ВидТипа = "ПланСчетов" Или ВидТипа = "ПланВидовРасчета" Или ВидТипа = "БизнесПроцесс"
			Или ВидТипа = "Задача" Тогда
			ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Ссылка", "NVARCHAR(36)",
				0, ВидТипа, МетаданныеТипа.Имя, "");
		Иначе
			ДобавитьКолонку(Колонки, Использованные, Реквизит.Имя, Реквизит.Имя, "Составной", "NVARCHAR(MAX)");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

