&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = Ext1_СинхронизацияSQL.ПолучитьНастройки();

	СтрокаПодключения = Настройки.СтрокаПодключения;
	СинхронизироватьПриЗаписи = Настройки.СинхронизироватьПриЗаписи;
	СинхронизироватьПриЗапуске = Настройки.СинхронизироватьПриЗапуске;
	ИспользоватьРегламентноеЗадание = Настройки.ИспользоватьРегламентноеЗадание;
	ИнтервалМинут = Настройки.ИнтервалМинут;

	ЗаполнитьТаблицуОбъектов(Настройки.Объекты);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОбъектов(Выбранные)

	ТаблицаОбъектов.Очистить();

	Для Каждого МетаданныеОбъекта Из Метаданные.Справочники Цикл
		ДобавитьСтрокуТаблицы(МетаданныеОбъекта, Выбранные);
	КонецЦикла;

	Для Каждого МетаданныеОбъекта Из Метаданные.Документы Цикл
		ДобавитьСтрокуТаблицы(МетаданныеОбъекта, Выбранные);
	КонецЦикла;

	ТаблицаОбъектов.Сортировать("ПолноеИмя");

КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуТаблицы(МетаданныеОбъекта, Выбранные)

	ТекСтрока = ТаблицаОбъектов.Добавить();
	ТекСтрока.ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
	ТекСтрока.Синоним = Строка(МетаданныеОбъекта.Синоним);
	ТекСтрока.Использовать = (Выбранные.Найти(ТекСтрока.ПолноеИмя) <> Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	УстановитьФлаги(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	УстановитьФлаги(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлаги(Значение)

	Для Каждого ТекСтрока Из ТаблицаОбъектов Цикл
		ТекСтрока.Использовать = Значение;
	КонецЦикла;

---

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки сохранены, расписание применено'"));

КонецПроцедуры

&НаКлиенте
Процедура Запустить(Команда)

	СохранитьНаСервере();
	
	// Выполняем синхронно на клиенте/сервере для отладки, 
	// чтобы сразу увидеть ошибку, если она возникнет, а не прятать её в фоне.
	Результат = ЗапуститьСинхронноНаСервере();
	Если ПустаяСтрока(Результат) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Полная синхронизация успешно завершена!'"));
	Иначе
		ВызватьИсключение Результат;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	Выбранные = Новый Массив;
	Для Каждого ТекСтрока Из ТаблицаОбъектов Цикл
		Если ТекСтрока.Использовать Тогда
			Выбранные.Добавить(ТекСтрока.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Настройки = Новый Структура("СтрокаПодключения, Объекты, СинхронизироватьПриЗаписи, СинхронизироватьПриЗапуске, ИспользоватьРегламентноеЗадание, ИнтервалМинут",
		СтрокаПодключения, Выбранные, СинхронизироватьПриЗаписи, СинхронизироватьПриЗапуске,
		ИспользоватьРегламентноеЗадание, ИнтервалМинут);

	Ext1_СинхронизацияSQL.СохранитьНастройки(Настройки);
	Ext1_СинхронизацияSQL.ПрименитьРасписание();

КонецПроцедуры

&НаСервере
Функция ЗапуститьСинхронноНаСервере()
	
	Возврат Ext1_СинхронизацияSQL.ВыполнитьПолнуюСинхронизациюБезопасно();

КонецФункции